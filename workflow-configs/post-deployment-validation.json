{
  "apiVersion": "syssetup/workflow-config/v1",
  "workflow": "post-deployment-validation",
  "steps": {
    "service-check": [
      {
        "args": [
          "verify",
          "namespace=pramf01",
          "services=aerospike comm-sbi dns dns-http ebm-svc-udp gtp-http mm mm-controller-external mm-controller-internal netconf nm-loadbalancer-svc nm-postgres nm-postgres-config nm-postgres-repl redis redis-sentinel sctp-http sctp-sctp-field",
          "external_ip_expectations=comm-sbi=192.168.5.90;dns-http=192.168.5.90;ebm-svc-udp=192.168.5.90;gtp-http=10.0.1.100;mm-controller-external=192.168.5.90;nm-loadbalancer-svc=192.168.5.90,68.240.20.130;sctp-http=10.55.71.52",
          "tcp_probe=true",
          "probe_targets=all",
          "connect_timeout=3"
        ]
      }
    ],
    "resource-check": [
      {
        "args": [
          "verify",
          "namespace=pramf01",
          "sheet=VDU",
          "header_row=1",
          "attribute_column=B",
          "service_start_column=D",
          "cpu_default_unit=m",
          "memory_default_unit=Mi",
          "extra_policy=warn",
          "show_pass=false"
        ],
        "artifacts": [
          {
            "id": "input-file",
            "source": "artifacts/pramf01-input_100K.xlsx"
          },
          {
            "id": "checker",
            "source": "../features/k8s-resource-check/check.py"
          }
        ]
      }
    ],
    "env-check": [
      {
        "args": [
          "verify",
          "namespace=pramf01",
          "sheet=VDU",
          "header_row=1",
          "attribute_column=B",
          "env_name_column=C",
          "service_start_column=D",
          "attribute_prefix=environments_",
          "compare_values=true",
          "extra_policy=warn",
          "show_pass=false"
        ],
        "artifacts": [
          {
            "id": "input-file",
            "source": "artifacts/pramf01-input_100K.xlsx"
          },
          {
            "id": "checker",
            "source": "../features/k8s-env-check/check.py"
          }
        ]
      }
    ],
    "connectivity-check": [
      {
        "args": [
          "verify",
          "phase=all",
          "namespace=pramf01",
          "vip_comm=68.240.36.9",
          "vip_ipgw=68.240.36.1",
          "vip_gtp=68.240.36.96",
          "ip_ausf=68.240.36.153",
          "ip_udm=68.240.36.153",
          "ip_smf=68.240.36.105",
          "ip_amf_remote=68.240.36.9",
          "ip_nrf=68.240.36.193",
          "ip_gnodeb=69.69.0.150",
          "curl_ausf_urls=http://68.240.36.153/",
          "curl_udm_urls=http://68.240.36.153/",
          "curl_smf_urls=http://68.240.36.105/",
          "curl_amf_remote_urls=http://68.240.36.9/",
          "curl_nrf_urls=http://68.240.36.193/",
          "curl_connect_timeout_seconds=3",
          "curl_max_time_seconds=10",
          "curl_insecure=false"
        ]
      }
    ]
  }
}
