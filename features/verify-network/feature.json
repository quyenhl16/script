{
  "apiVersion": "syssetup/v1",
  "id": "verify-network",
  "name": "Verify Bond VLAN Interfaces",
  "version": "1.1.0",
  "description": "Check that bond VLAN interfaces exist and are UP on remote servers",
  "entrypoint": "run.sh",
  "supportedOS": ["rhel", "centos", "rocky", "almalinux", "fedora"],
  "requireRoot": false,
  "remoteOnly": true,
  "remoteArgsExample": "bond2.306 bond2.307",
  "timeoutSeconds": 30
}
