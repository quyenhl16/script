{
  "apiVersion": "syssetup/v1",
  "id": "verify-xml-config",
  "name": "Verify XML Configuration",
  "version": "1.0.0",
  "description": "Validate important XML values against a declarative JSON rule set on remote servers",
  "entrypoint": "run.sh",
  "supportedOS": ["rhel", "centos", "rocky", "almalinux", "fedora"],
  "requireRoot": false,
  "remoteOnly": true,
  "remoteArgsExample": "--rules /etc/syssetup/system-critical-paths.json",
  "timeoutSeconds": 120
}
