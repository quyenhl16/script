{
  "apiVersion": "syssetup/v1",
  "name": "k8s-env-check",
  "description": "Compare Kubernetes workload environments with an Excel baseline",
  "features": [
    {
      "id": "k8s-env-check",
      "parameters": {
        "input_file": "pramf01-input_100K.xlsx",
        "namespace": "pramf01",
        "sheet": "VDU",
        "header_row": 1,
        "attribute_column": "B",
        "env_name_column": "C",
        "service_start_column": "D",
        "attribute_prefix": "environments_",
        "mapping_file": "",
        "compare_values": true,
        "extra_policy": "warn",
        "ignore_extra": "",
        "show_pass": false
      }
    }
  ]
}
