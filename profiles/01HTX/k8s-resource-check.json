{
  "apiVersion": "syssetup/v1",
  "name": "k8s-resource-check",
  "description": "Compare Kubernetes workload resources with an Excel baseline",
  "features": [
    {
      "id": "k8s-resource-check",
      "parameters": {
        "input_file": "pramf01-input_100K.xlsx",
        "namespace": "pramf01",
        "sheet": "VDU",
        "header_row": 1,
        "attribute_column": "B",
        "service_start_column": "D",
        "mapping_file": "",
        "cpu_default_unit": "m",
        "memory_default_unit": "Mi",
        "extra_policy": "warn",
        "ignore_extra": "",
        "show_pass": false
      }
    }
  ]
}
